#!/usr/bin/env bash
# Repo pre-commit checks. Enable with `uv run lc hooks`; bypass once with
# `git commit --no-verify`.
set -uo pipefail

cd "$(git rev-parse --show-toplevel)" || exit 1

# Nothing to check when no Python or notebook is staged (README-only commits).
if ! git diff --cached --name-only --diff-filter=ACM | grep -qE '\.(py|ipynb)$'; then
  exit 0
fi

status=0
run() {
  echo "pre-commit: $*"
  "$@" || status=1
}

run uv run lc nb --check
run uv run ruff format --check .
run uv run ruff check .
run uv run pytest -q

if [ "$status" -ne 0 ]; then
  echo
  echo "pre-commit failed. Fix the above, or commit with --no-verify to skip."
fi
exit "$status"
